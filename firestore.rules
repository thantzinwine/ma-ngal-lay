rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ma Ngal Lay is a small, trusted-shop shared store. The web config is
    // public, so anyone with the URL can read/write these three collections.
    // Do not put sensitive data in this project.
    match /products/{productId} {
      allow read, write: if true;
    }
    match /sales/{saleId} {
      allow read, write: if true;
    }
    match /changes/{changeId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
